{
  "name": "octopus-expertise",
  "version": "0.1.0",
  "private": true,
  "description": "OCTOPUS Expertise web platform monorepo",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm run dev --workspace @octopus/web\" \"npm run start:dev --workspace @octopus/api\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format:check": "prettier --check apps docs README.md AGENTS.md package.json compose.yaml",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  }
}
